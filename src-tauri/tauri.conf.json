{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Portolano",
  "version": "0.4.1-rc1",
  "identifier": "net.portolano.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --dir ui dev",
    "beforeBuildCommand": "pnpm --dir ui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Portolano",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: https://portolano.cloud; style-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'none'; object-src 'none'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; img-src 'self' data: blob: https://portolano.cloud; style-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Simone Amato",
    "homepage": "https://github.com/reallovedone/portolano",
    "copyright": "© 2026 Simone Amato",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "DeveloperTool",
    "shortDescription": "One window for every remote connection",
    "longDescription": "Portolano is a personal remote-connection manager for system administrators: SSH, RDP, VNC, web consoles and local shells in tabs, with an encrypted vault for credentials.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/reallovedone/portolano/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3NjcyQTQ0QzkyRDg1OEUKUldTT2hTM0pSQ3BuaDZkYlhwdUdRN1lMTW1qZzF3TGVJWDBKWTgrVUc1U0x3VkJaM3MzaXVnK1IK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
